---
const towns = [
  { name: 'Hilo', x: 78, y: 134 },
  { name: 'Keaau', x: 69, y: 142 },
  { name: 'Mountain View', x: 58, y: 155 },
  { name: 'Kurtistown', x: 63, y: 149 },
  { name: 'Pahoa', x: 88, y: 149 },
  { name: 'Volcano', x: 51, y: 172 }
];
---
<div class="card pad map-card">
  <div class="eyebrow">Service area map</div>
  <h3 class="h3" style="margin-bottom:1rem;">East side Big Island coverage</h3>
  <svg viewBox="0 0 220 240" role="img" aria-label="Stylized east side Big Island service area map with town markers">
    <defs>
      <linearGradient id="ocean" x1="0" x2="1">
        <stop offset="0%" stop-color="#e0f2fe" />
        <stop offset="100%" stop-color="#bfdbfe" />
      </linearGradient>
      <linearGradient id="land" x1="0" x2="1">
        <stop offset="0%" stop-color="#d1fae5" />
        <stop offset="100%" stop-color="#a7f3d0" />
      </linearGradient>
    </defs>
    <rect width="220" height="240" rx="24" fill="url(#ocean)" />
    <path d="M26 45 C72 18, 150 28, 189 82 C204 104, 198 128, 183 152 C166 178, 148 205, 109 213 C74 220, 47 196, 34 173 C19 148, 10 110, 14 87 C18 68, 18 52, 26 45 Z" fill="url(#land)" stroke="#0f766e" stroke-width="3" />
    <path d="M143 67 C152 89, 164 104, 179 124" fill="none" stroke="#0ea5e9" stroke-width="6" stroke-linecap="round" opacity=".75" />
    {towns.map((town) => (
      <g>
        <circle cx={town.x} cy={town.y} r="5.5" fill="#0369a1" />
        <text x={town.x + 8} y={town.y + 4} font-size="10" font-weight="700" fill="#0f172a">{town.name}</text>
      </g>
    ))}
  </svg>
  <p class="copy" style="margin-top:1rem;">A custom service-area graphic helps reinforce local positioning for East Hawaii homeowners.</p>
</div>
