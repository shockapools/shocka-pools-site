---
import MainLayout from '../../layouts/MainLayout.astro';
import { business, services } from '../../components/data';

const title = 'Services | Shocka Pools';
const description = 'Explore pool service, above-ground pool installation support, catchment tank cleaning, tank removal and build support, and rain gutter service from Shocka Pools in East Hawaii.';
---
<MainLayout title={title} description={description} path="/services/" keywords={['pool service Hawaii', 'catchment tank service Hawaii', 'rain gutter service Hawaii', ...business.serviceAreas]}>
  <section class="section">
    <div class="container stack">
      <div class="breadcrumbs"><a href="/">Home</a> / Services</div>
      <div>
        <p class="eyebrow">Services</p>
        <h1 class="h2">Reliable help for pools, catchment systems, tank projects, and rain gutters across East Hawaii.</h1>
        <p class="copy" style="max-width:68ch;">From routine maintenance to bigger water-system projects, each service is written for local homeowners who want clear communication, practical recommendations, and a straightforward quote process.</p>
      </div>

      <div class="grid">
        {services.map((service) => (
          <article class="card pad" id={service.slug}>
            <div class="split">
              <div class="stack">
                <div>
                  <p class="eyebrow">{service.title}</p>
                  <h2 class="h3">{service.title}</h2>
                </div>
                <p class="copy">{service.details}</p>
              </div>
              <div class="card pad" style="background:#f8fafc; box-shadow:none;">
                <div class="eyebrow">Common service needs</div>
                <ul class="list-clean">
                  {service.bullets.map((item) => <li><span class="check">✓</span><span>{item}</span></li>)}
                </ul>
              </div>
            </div>
          </article>
        ))}
      </div>

      <div class="card pad" style="background:#e0f2fe;">
        <h2 class="h3">Need help deciding what to ask for?</h2>
        <p class="copy">Use the quote form for routine service, one-time cleanups, above-ground pool setup, old tank removal, new catchment builds, or questions about whether a job falls within the current East Hawaii service area.</p>
        <a class="btn btn-primary" href="/contact/">Go to Quote Form</a>
      </div>
    </div>
  </section>
</MainLayout>
