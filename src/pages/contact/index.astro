---
import MainLayout from '../../layouts/MainLayout.astro';
import ContactForm from '../../components/ContactForm.astro';
import { business } from '../../components/data';

const title = 'Contact | Shocka Pools';
const description = 'Request a quote from Shocka Pools for pool service, catchment tank service, or rain gutter service in East Hawaii.';
---
<MainLayout title={title} description={description} path="/contact/" keywords={['Shocka Pools contact', 'East Hawaii quote request', 'pool quote Big Island']}>
  <section class="section">
    <div class="container split">
      <div class="stack">
        <div class="breadcrumbs"><a href="/">Home</a> / Contact</div>
        <div>
          <p class="eyebrow">Contact</p>
          <h1 class="h2">Get in touch with Shocka Pools.</h1>
        </div>
        <p class="copy">
          Reach out for a quote, ask about service in your area, or let Shocka Pools know what kind of help you need. The form below is set up for Netlify Forms and ready for deployment.
        </p>

        <div class="card pad">
          <div class="stack">
            <div><strong>Owner:</strong> {business.owner}</div>
            <div><strong>Phone:</strong> <a href={business.phoneHref}>{business.phoneDisplay}</a></div>
            <div><strong>Email:</strong> <a href={`mailto:${business.email}`}>{business.email}</a></div>
            <div><strong>Service focus:</strong> {business.serviceAreaShort}</div>
          </div>
        </div>
      </div>

      <div class="card pad">
        <ContactForm />
      </div>
    </div>
  </section>
</MainLayout>
