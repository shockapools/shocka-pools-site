---
import MainLayout from '../layouts/MainLayout.astro';
import ServiceCards from '../components/ServiceCards.astro';
import Reviews from '../components/Reviews.astro';
import BeforeAfterGallery from '../components/BeforeAfterGallery.astro';
import ContactForm from '../components/ContactForm.astro';
import { business } from '../components/data';

const title = 'Shocka Pools | Pool, Catchment Tank, Pool Installation, and Rain Gutter Service on the Big Island';
const description = 'Shocka Pools provides pool service, catchment tank cleaning, pool installation support, catchment tank removal and builds, and rain gutter service on the east side of the Big Island of Hawaii.';
const schema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: business.name,
  image: 'https://shockapools.com/images/logo.png',
  url: 'https://shockapools.com/',
  telephone: '+1-808-333-0615',
  email: business.email,
  areaServed: business.serviceAreas.map((area) => ({ '@type': 'City', name: area })),
  serviceType: business.services,
  founder: business.owner,
  address: { '@type': 'PostalAddress', addressRegion: 'HI', addressCountry: 'US' }
};
---
<MainLayout title={title} description={description} path="/" keywords={[...business.serviceAreas, ...business.services, 'Big Island pool service', 'East Hawaii pool service']} schema={schema}>
  <section class="hero section">
    <div class="container hero-grid hero-grid-balanced">
      <div class="stack hero-copy">
        <div class="hero-badge">Proudly serving the east side of the Big Island</div>
        <h1 class="h1">Reliable water-system service for East Hawaii homes.</h1>
        <p class="lead">
          Shocka Pools helps homeowners keep pools, catchment tanks, gutters, and above-ground pool projects handled with care. From catchment cleaning starting at <strong>$299+</strong> to pool setup, tank removal, and new catchment builds, every job is handled with clear communication and direct owner involvement.
        </p>
        <div class="hero-actions">
          <a class="btn btn-primary" href={business.phoneHref}>Call {business.phoneDisplay}</a>
          <a class="btn btn-secondary" href="/contact/">Request a Quote</a>
        </div>
      </div>

      <div class="card pad hero-card">
        <img class="hero-logo" src="/images/logo-circle.png" alt="Shocka Pools logo" />
        <div class="grid hero-info-grid">
          <div class="card pad hero-info-card">
            <div class="eyebrow">Owner</div>
            <div class="h3">{business.owner}</div>
          </div>
          <div class="card pad hero-info-card">
            <div class="eyebrow">Core services</div>
            <div class="copy"><strong>{business.services.join(' • ')}</strong></div>
          </div>
          <div class="card pad hero-info-card">
            <div class="eyebrow">Catchment cleaning</div>
            <div class="copy"><strong>Starting at $299+</strong></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container stack centered-section">
      <div>
        <p class="eyebrow">What we do</p>
        <h2 class="h2">Professional help for the water systems your home depends on.</h2>
        <p class="copy">
          Whether it is keeping a pool swim-ready, cleaning a catchment tank, removing an abandoned tank, preparing a new catchment build, setting up an above-ground pool, or clearing gutters before the next hard rain, Shocka Pools is built around practical service and trust.
        </p>
      </div>
      <ServiceCards />
    </div>
  </section>

  <section class="section ash-alert-section">
    <div class="container ash-alert card pad">
      <div>
        <p class="eyebrow">Volcanic ash + rainfall reminder</p>
        <h2 class="h2">When ash and debris hit your roof, your catchment tank catches it too.</h2>
      </div>
      <p class="copy">If your water has been looking cloudy, smelling off, or your tank has not been checked in a while, now is the time. Shocka Pools can inspect the system, clean buildup, and help you stay ahead of bigger water issues.</p>
      <a class="btn btn-primary" href={business.phoneHref}>Call {business.phoneDisplay}</a>
    </div>
  </section>

  <section class="section" style="background:#fff;">
    <div class="container stack centered-section">
      <div>
        <p class="eyebrow">Why East Hawaii homeowners respond to this</p>
        <h2 class="h2">Local, respectful, and easy to work with.</h2>
      </div>
      <p class="copy">
        On the east side, homeowners care about reliability. They want someone who communicates clearly, treats the property with care, and understands the realities of living with pools, catchment systems, heavy rainfall, volcanic ash, jungle debris, and catchment-based water systems.
      </p>
      <ul class="list-clean grid grid-2 trust-list">
        <li><span class="check">✓</span><span>Local East Hawaii service</span></li>
        <li><span class="check">✓</span><span>Direct owner contact</span></li>
        <li><span class="check">✓</span><span>Above-ground pool install support</span></li>
        <li><span class="check">✓</span><span>Catchment cleaning starting at $299+</span></li>
        <li><span class="check">✓</span><span>Old tank removal and new tank build support</span></li>
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container stack centered-section">
      <div>
        <p class="eyebrow">Why homeowners call Shocka Pools</p>
        <h2 class="h2">Built for trust before we ever step on your property.</h2>
        <p class="copy">Local understanding, dependable communication, and practical help with the systems your home relies on.</p>
      </div>
      <Reviews />
    </div>
  </section>


  <section class="section" style="background:#fff;">
    <div class="container stack">
      <div>
        <p class="eyebrow">Before and after photos</p>
        <h2 class="h2">Catchment cleaning results you can actually see.</h2>
        <p class="copy" style="max-width:64ch;">When's the last time you checked your tank? These before-and-after photos show the kind of buildup Shocka Pools removes from catchment systems across East Hawaii.</p>
      </div>
      <BeforeAfterGallery />
    </div>
  </section>cd 
  <section class="section">
    <div class="container split contact-balance">
      <div class="stack">
        <div>
          <p class="eyebrow">Quote request</p>
          <h2 class="h2">Tell Shocka Pools what you need.</h2>
        </div>
        <p class="copy">
          Submit the form and Shocka Pools will follow up directly. Every required field helps get enough information to respond with a useful next step.
        </p>
        <div class="card pad">
          <div class="info-list">
            <div class="info-item"><strong>Phone:</strong> <a href={business.phoneHref}>{business.phoneDisplay}</a></div>
            <div class="info-item"><strong>Email:</strong> <a href={`mailto:${business.email}`}>{business.email}</a></div>
            <div class="info-item"><strong>Service area:</strong> <span>{business.serviceAreaShort}</span></div>
          </div>
        </div>
      </div>
      <div class="card pad">
        <ContactForm compact={true} />
      </div>
    </div>
  </section>
</MainLayout>cd ~/Downloads/shocka-pools-site
