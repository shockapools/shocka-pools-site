---
import MainLayout from '../layouts/MainLayout.astro';
import ServiceCards from '../components/ServiceCards.astro';
import Reviews from '../components/Reviews.astro';
import BeforeAfterGallery from '../components/BeforeAfterGallery.astro';
import ServiceAreaMap from '../components/ServiceAreaMap.astro';
import ContactForm from '../components/ContactForm.astro';
import { business } from '../components/data';

const title = 'Shocka Pools | Pool, Catchment Tank, and Rain Gutter Service on the Big Island';
const description = 'Shocka Pools provides pool service, catchment tank service, and rain gutter service on the east side of the Big Island of Hawaii.';
const schema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: business.name,
  image: 'https://shockapools.com/images/logo.png',
  url: 'https://shockapools.com/',
  telephone: '+1-808-333-0615',
  email: business.email,
  areaServed: business.serviceAreas.map((area) => ({ '@type': 'City', name: area })),
  serviceType: business.services,
  founder: business.owner,
  address: { '@type': 'PostalAddress', addressRegion: 'HI', addressCountry: 'US' }
};
---
<MainLayout title={title} description={description} path="/" keywords={[...business.serviceAreas, ...business.services, 'Big Island pool service', 'East Hawaii pool service']} schema={schema}>
  <section class="hero section">
    <div class="container hero-grid">
      <div class="stack">
        <div class="hero-badge">Proudly serving the east side of the Big Island</div>
        <h1 class="h1">Honest, dependable service for pools, catchment tanks, and rain gutters in East Hawaii.</h1>
        <p class="lead">
          Shocka Pools helps homeowners keep essential water systems clean, maintained, and working the way they should. Local service, respectful communication, and practical help from a Big Island business focused on the east side.
        </p>
        <div style="display:flex; gap:1rem; flex-wrap:wrap;">
          <a class="btn btn-primary" href={business.phoneHref}>Call {business.phoneDisplay}</a>
          <a class="btn btn-secondary" href="/contact/">Request a Quote</a>
        </div>
      </div>

      <div class="card pad" style="background:rgba(255,255,255,.12); border-color:rgba(255,255,255,.18); color:#fff;">
        <img src="/images/logo.png" alt="Shocka Pools logo" style="width:160px;height:160px;margin:0 auto 1.25rem;" />
        <div class="grid">
          <div class="card pad" style="background:rgba(255,255,255,.95); color:#0f172a;">
            <div class="eyebrow" style="margin-bottom:.35rem;">Owner</div>
            <div class="h3">{business.owner}</div>
          </div>
          <div class="card pad" style="background:rgba(255,255,255,.95); color:#0f172a;">
            <div class="eyebrow" style="margin-bottom:.35rem;">Core services</div>
            <div class="copy" style="color:#0f172a; font-weight:700;">{business.services.join(' • ')}</div>
          </div>
          <div class="card pad" style="background:rgba(255,255,255,.95); color:#0f172a;">
            <div class="eyebrow" style="margin-bottom:.35rem;">Current service focus</div>
            <div class="copy" style="color:#0f172a; font-weight:700;">{business.serviceAreaShort}</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container stack">
      <div>
        <p class="eyebrow">What we do</p>
        <h2 class="h2">Straightforward local service for the systems your home depends on.</h2>
        <p class="copy" style="max-width:60ch;">
          Whether it is keeping a pool swim-ready, helping maintain a catchment system, or clearing gutters before the next hard rain, Shocka Pools is built around practical service and trust.
        </p>
      </div>
      <ServiceCards />
    </div>
  </section>

  <section class="section" style="background:#fff;">
    <div class="container split">
      <div class="stack">
        <div>
          <p class="eyebrow">Why East Hawaii homeowners respond to this</p>
          <h2 class="h2">Local, respectful, and easy to work with.</h2>
        </div>
        <p class="copy">
          On the east side, homeowners care about reliability. They want someone who communicates clearly, treats the property with care, and understands the realities of living with pools, catchment systems, and heavy rainfall.
        </p>
        <ul class="list-clean">
          <li><span class="check">✓</span><span>Local East Hawaii positioning</span></li>
          <li><span class="check">✓</span><span>Direct owner contact</span></li>
          <li><span class="check">✓</span><span>Simple quote request flow</span></li>
          <li><span class="check">✓</span><span>SEO pages for nearby service towns</span></li>
        </ul>
      </div>
      <ServiceAreaMap />
    </div>
  </section>

  <section class="section">
    <div class="container stack">
      <div>
        <p class="eyebrow">Why homeowners call Shocka Pools</p>
        <h2 class="h2">A trust-building section that works even before formal reviews come in.</h2>
        <p class="copy" style="max-width:60ch;">Until verified customer reviews are available, this section explains the practical reasons East Hawaii homeowners are likely to reach out: local understanding, dependable communication, and help with essential home water systems.</p>
      </div>
      <Reviews />
    </div>
  </section>

  <section class="section" style="background:#fff;">
    <div class="container stack">
      <div>
        <p class="eyebrow">Before and after photos</p>
        <h2 class="h2">Project gallery structure, ready for real job photos.</h2>
      </div>
      <BeforeAfterGallery />
    </div>
  </section>

  <section class="section">
    <div class="container split">
      <div class="stack">
        <div>
          <p class="eyebrow">Quote request</p>
          <h2 class="h2">Tell Shocka Pools what you need.</h2>
        </div>
        <p class="copy">
          This form is production-ready for Netlify Forms and collects the core details needed for a callback or quote request.
        </p>
        <div class="card pad">
          <div class="info-list">
            <div class="info-item"><strong>Phone:</strong> <a href={business.phoneHref}>{business.phoneDisplay}</a></div>
            <div class="info-item"><strong>Email:</strong> <a href={`mailto:${business.email}`}>{business.email}</a></div>
            <div class="info-item"><strong>Service area:</strong> <span>{business.serviceAreaShort}</span></div>
          </div>
        </div>
      </div>
      <div class="card pad">
        <ContactForm compact={true} />
      </div>
    </div>
  </section>
</MainLayout>
