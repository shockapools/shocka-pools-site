---
import MainLayout from '../layouts/MainLayout.astro';

const title = 'Thanks | Shocka Pools';
const description = 'Thanks for contacting Shocka Pools.';
---

<MainLayout title={title} description={description} path="/thanks/">
  <section class="section">
    <div class="container stack" style="text-align:center; max-width:760px; margin:0 auto;">
      <p class="eyebrow">Request received</p>
      <h1 class="h1">Thanks — your quote request was sent.</h1>
      <p class="lead">
        Shocka Pools received your information and will follow up as soon as possible.
      </p>
      <div style="display:flex; gap:1rem; justify-content:center; flex-wrap:wrap; margin-top:1.5rem;">
        <a class="btn btn-primary" href="tel:+18083330615">Call Now</a>
        <a class="btn btn-secondary" href="/">Back to Home</a>
      </div>
    </div>
  </section>
</MainLayout>
