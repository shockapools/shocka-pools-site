---
const towns = [
  { name: 'Hilo', x: 330, y: 138 },
  { name: 'Keaau', x: 334, y: 185 },
  { name: 'HPP', x: 347, y: 210 },
  { name: 'Pahoa', x: 350, y: 252 },
  { name: 'Kalapana', x: 322, y: 318 },
  { name: 'Kurtistown', x: 312, y: 218 },
  { name: 'Mountain View', x: 287, y: 266 },
  { name: 'Volcano', x: 245, y: 326 }
];
---
<section class="section coverage-section">
  <div class="container split coverage-grid">
    <div class="stack centered-copy">
      <p class="eyebrow">Service area</p>
      <h2 class="h2">East side Big Island coverage from Hilo down toward Kalapana.</h2>
      <p class="copy">
        Reliable local service. Clear communication. Practical solutions for East Hawaii homes.
Shocka Pools focuses on East Hawaii and the windward side of Hawaiʻi Island, where heavy rain, volcanic ash, forest debris, and catchment-based water systems are part of everyday property care.
      </p>
      <div class="pill-row surface-pills">
        <span class="pill">Hilo</span>
        <span class="pill">Keaau</span>
        <span class="pill">HPP</span>
        <span class="pill">Pahoa</span>
        <span class="pill">Kalapana</span>
        <span class="pill">Mountain View</span>
        <span class="pill">Kurtistown</span>
        <span class="pill">Volcano</span>
      </div>
      <p class="copy small-note">Clean service-area graphic showing the east and southeast side of Hawaiʻi Island, built to load fast and avoid third-party map issues.</p>
    </div>

    <div class="card pad map-shell island-map-shell">
      <svg class="island-map" viewBox="0 0 430 520" role="img" aria-label="Big Island service area map showing East Hawaii coverage from Hilo to Kalapana">
        <defs>
          <linearGradient id="islandLand" x1="0" x2="1" y1="0" y2="1">
            <stop offset="0%" stop-color="#f8fafc" />
            <stop offset="54%" stop-color="#e0f2fe" />
            <stop offset="100%" stop-color="#cbd5e1" />
          </linearGradient>
          <linearGradient id="eastZone" x1="0" x2="1" y1="0" y2="1">
            <stop offset="0%" stop-color="#7dd3fc" stop-opacity=".84" />
            <stop offset="58%" stop-color="#0ea5e9" stop-opacity=".78" />
            <stop offset="100%" stop-color="#0369a1" stop-opacity=".86" />
          </linearGradient>
          <filter id="mapShadow" x="-20%" y="-20%" width="140%" height="140%">
            <feDropShadow dx="0" dy="10" stdDeviation="11" flood-color="#020617" flood-opacity=".16" />
          </filter>
        </defs>

        <rect x="0" y="0" width="430" height="520" rx="26" fill="#f8fafc" />
        <path class="ocean-line" d="M24 445 C105 402 185 439 272 404 C330 381 363 332 396 293" />
        <path class="ocean-line faint" d="M18 384 C103 352 158 385 248 360 C327 338 357 292 406 250" />

        <!-- More recognizable Hawaiʻi Island outline: Kohala at top, Hamakua/Hilo coast east, Puna point southeast, Kaʻū south, Kona coast west -->
        <path class="big-island-outline" filter="url(#mapShadow)" d="M191 27
          C221 26 246 43 264 69
          C278 88 291 102 309 118
          C340 146 363 185 375 226
          C391 278 383 324 349 359
          C326 383 306 397 291 429
          C274 465 236 490 195 492
          C158 494 127 471 109 440
          C89 405 84 371 64 342
          C42 310 31 273 39 232
          C46 194 61 165 64 132
          C68 88 101 50 141 36
          C158 30 173 27 191 27 Z" />

        <path class="east-service-zone" d="M285 98
          C318 128 349 171 363 219
          C379 273 371 318 340 353
          C318 377 301 391 286 421
          C270 453 239 477 201 483
          C221 449 241 414 254 374
          C268 330 274 283 277 235
          C280 184 282 141 285 98 Z" />

        <path class="coast-emphasis" d="M286 97
          C319 128 350 172 364 219
          C379 272 371 318 341 352
          C318 377 302 391 287 421
          C271 452 239 477 202 483" />

        <path class="saddle-road" d="M149 165 C194 152 242 151 306 137" />
        <path class="volcano-road" d="M157 312 C196 302 237 302 298 321" />

        <circle class="volcano" cx="176" cy="149" r="32" />
        <text class="geo-label" x="129" y="151">Mauna Kea</text>
        <circle class="volcano" cx="159" cy="286" r="46" />
        <text class="geo-label" x="105" y="292">Mauna Loa</text>
        <circle class="volcano active" cx="236" cy="329" r="24" />
        <text class="geo-label" x="207" y="365">Kīlauea</text>

        {towns.map((town) => (
          <g class="town-marker">
            <circle cx={town.x} cy={town.y} r="8" />
            <text x={town.x + 13} y={town.y + 5}>{town.name}</text>
          </g>
        ))}

        <text class="map-label" x="229" y="58">East Hawaii</text>
        <text class="map-label-small" x="232" y="78">service zone</text>
      </svg>
    </div>
  </div>
</section>
