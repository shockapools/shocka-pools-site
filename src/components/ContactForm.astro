---
const { compact = false } = Astro.props;
---
<form
  name="quote-request"
  method="POST"
  action="/thanks/"
  data-netlify="true"
  netlify-honeypot="bot-field"
  class="form-grid"
>
  <input type="hidden" name="form-name" value="quote-request" />
  <p class="sr-only">
    <label>
      Don’t fill this out if you're human: <input name="bot-field" />
    </label>
  </p>

  <div class="field-grid">
    <label>
      <span>Full Name</span>
      <input type="text" name="name" required />
    </label>
    <label>
      <span>Best Callback Number</span>
      <input type="tel" name="phone" required />
    </label>
  </div>

  <div class="field-grid">
    <label>
      <span>Email Address</span>
      <input type="email" name="email" />
    </label>
    <label>
      <span>Area / Town</span>
      <select name="area" required>
        <option value="">Select your area</option>
        <option>Hilo</option>
        <option>Pahoa</option>
        <option>Keaau</option>
        <option>Mountain View</option>
        <option>Kurtistown</option>
        <option>Volcano</option>
        <option>Other East Hawaii Area</option>
      </select>
    </label>
  </div>

  <label>
    <span>What service do you need?</span>
    <select name="service" required>
      <option value="">Select a service</option>
      <option>Pool Service</option>
      <option>Catchment Tank Service</option>
      <option>Rain Gutter Service</option>
      <option>Multiple Services</option>
      <option>General Question</option>
    </select>
  </label>

  <label>
    <span>Project Details</span>
    <textarea name="details" rows={compact ? 4 : 6} placeholder="Tell Shocka Pools a little about what you need and the best time to reach you."></textarea>
  </label>

  <button class="btn btn-primary" type="submit">Send Quote Request</button>
</form>
