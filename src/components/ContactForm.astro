---
const { compact = false } = Astro.props;
const serviceOptions = [
  'Pool Service',
  'Above-Ground Pool Installation Support',
  'Catchment Tank Cleaning',
  'Catchment Tank Removal / New Build Support',
  'Rain Gutter Service',
  'General Question'
];
---
<form
  name="quote-request"
  method="POST"
  action="/thanks/"
  data-netlify="true"
  netlify-honeypot="bot-field"
  class="form-grid quote-form"
>
  <input type="hidden" name="form-name" value="quote-request" />
  <input type="hidden" name="send-to" value="shockapools@gmail.com" />
  <p class="sr-only">
    <label>
      Don’t fill this out if you're human: <input name="bot-field" />
    </label>
  </p>

  <div class="field-grid">
    <label>
      <span>Full Name</span>
      <input type="text" name="name" autocomplete="name" required />
    </label>
    <label>
      <span>Best Callback Number</span>
      <input type="tel" name="phone" autocomplete="tel" required />
    </label>
  </div>

  <div class="field-grid">
    <label>
      <span>Email Address</span>
      <input type="email" name="email" autocomplete="email" required />
    </label>
    <label>
      <span>Area / Town</span>
      <select name="area" required>
        <option value="">Select your area</option>
        <option>Hilo</option>
        <option>Keaau</option>
        <option>HPP</option>
        <option>Pahoa</option>
        <option>Kalapana</option>
        <option>Mountain View</option>
        <option>Kurtistown</option>
        <option>Volcano</option>
        <option>Other East Hawaii Area</option>
      </select>
    </label>
  </div>

  <fieldset class="checkbox-field" data-service-group>
    <legend>What service do you need? <span>Select all that apply</span></legend>
    <div class="checkbox-grid">
      {serviceOptions.map((service) => (
        <label class="checkbox-option">
          <input type="checkbox" name="services" value={service} />
          <span>{service}</span>
        </label>
      ))}
    </div>
    <p class="form-error" data-service-error>Please select at least one service.</p>
  </fieldset>

  <label>
    <span>Project Details / Notes <em>(optional)</em></span>
    <textarea name="details" rows={compact ? 4 : 6} placeholder="Tell Shocka Pools a little about what you need, property access, tank/pool size, or the best time to reach you."></textarea>
  </label>

  <button class="btn btn-primary" type="submit">Send Quote Request</button>
</form>

<script>
  document.querySelectorAll('.quote-form').forEach((form) => {
    const serviceInputs = Array.from(form.querySelectorAll('input[name="services"]'));
    const error = form.querySelector('[data-service-error]');
    const validateServices = () => {
      const hasService = serviceInputs.some((input) => input.checked);
      form.classList.toggle('service-error-active', !hasService);
      if (error) error.setAttribute('aria-hidden', hasService ? 'true' : 'false');
      return hasService;
    };

    serviceInputs.forEach((input) => input.addEventListener('change', validateServices));
    form.addEventListener('submit', (event) => {
      if (!validateServices()) {
        event.preventDefault();
        serviceInputs[0]?.focus();
      }
    });
  });
</script>
