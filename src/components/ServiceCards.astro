---
import { services } from './data';
---
<div class="services-grid">
  {services.map((service) => (
    <article class="card pad service-card">
      <p class="eyebrow">{service.title}</p>
      <h3 class="h3">{service.title}</h3>
      <p>{service.summary}</p>
      <a class="btn btn-secondary" href="/services/">Learn More</a>
    </article>
  ))}
</div>
