---
import { business } from './data';
---
<footer class="footer">
  <div class="container section" style="padding: 2.5rem 0;">
    <div class="footer-grid">
      <div>
        <div class="logo-lockup">
          <img src="/images/logo.png" alt="Shocka Pools logo" />
          <div style="font-weight:900; font-size:1.1rem;">{business.name}</div>
        </div>
        <p class="copy" style="max-width:60ch; margin:.8rem 0 0;">
          Local service for pools, catchment tanks, and rain gutters on the east side of the Big Island of Hawaii.
        </p>
      </div>
      <div class="stack">
        <a href={business.phoneHref} style="font-weight:800;">{business.phoneDisplay}</a>
        <a href={`mailto:${business.email}`} style="font-weight:800;">{business.email}</a>
        <div class="muted">Owned and operated by {business.owner}</div>
      </div>
    </div>
  </div>
</footer>
