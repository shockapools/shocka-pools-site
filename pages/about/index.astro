---
import MainLayout from '../../layouts/MainLayout.astro';
import { business } from '../../components/data';

const title = 'About | Shocka Pools';
const description = 'Learn about Shocka Pools, a local East Hawaii business serving homeowners with pool, catchment tank, and rain gutter service.';
---
<MainLayout title={title} description={description} path="/about/" keywords={['about Shocka Pools', 'East Hawaii local business', 'Big Island pool company']}>
  <section class="section">
    <div class="container split">
      <div class="stack">
        <div class="breadcrumbs"><a href="/">Home</a> / About</div>
        <div>
          <p class="eyebrow">About Shocka Pools</p>
          <h1 class="h2">A strong local brand for East Hawaii homeowners.</h1>
        </div>
        <p class="copy">
          Shocka Pools is positioned as a dependable local company serving the east side of the Big Island with pool service, catchment tank service, and rain gutter service. The message is simple: respectful service, practical help, and clear communication.
        </p>
        <p class="copy">
          For many homes in East Hawaii, water systems are part of daily life. Pools need consistent care. Catchment systems need attention. Gutters need to stay clear when the rain comes down heavy. This site is built to feel local, trustworthy, and approachable without sounding generic.
        </p>
        <p class="copy">
          Owned and operated by <strong>{business.owner}</strong>, the business is focused on the east side for now, allowing the brand to grow with a practical service radius and strong word-of-mouth potential.
        </p>
      </div>

      <div class="grid">
        <div class="card pad">
          <div class="eyebrow">Mission</div>
          <h2 class="h3">Keep essential home water systems clean, maintained, and cared for.</h2>
        </div>
        <div class="card pad">
          <div class="eyebrow">Approach</div>
          <p class="copy">Clear communication, respectful service, local focus, and practical help for everyday homeowners on Hawaii Island.</p>
        </div>
        <div class="card pad">
          <div class="eyebrow">Future growth</div>
          <p class="copy">The site is ready for real customer reviews when available, while the current trust-building section already explains why East Hawaii homeowners are likely to call. It is also ready for project photography, FAQs, and additional area pages as the business grows.</p>
        </div>
      </div>
    </div>
  </section>
</MainLayout>
