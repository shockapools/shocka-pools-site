---
import { services } from './data';
---
<div class="grid grid-3">
  {services.map((service) => (
    <article class="card pad service-card">
      <p class="eyebrow" style="margin-bottom:.4rem;">{service.title}</p>
      <h3 class="h3">{service.title}</h3>
      <p>{service.summary}</p>
      <a class="btn btn-secondary" href="/services/" style="margin-top:1rem;">Learn More</a>
    </article>
  ))}
</div>
